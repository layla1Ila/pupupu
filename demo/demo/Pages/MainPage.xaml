<Page x:Class="demo.Pages.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:demo.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="MainPage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal">
            <TextBlock Text="Поиск" Margin="5"/>
            <TextBox x:Name="TBSearch"
                     TextChanged="TBSearch_TextChanged"
                     Width="200"
                     Margin="5"/>

            <TextBlock Text="Транспорт" Margin="5"/>
            <ComboBox x:Name="CBTransport"
                      Width="200"
                      Margin="5"
                      DisplayMemberPath="Name"
                      SelectionChanged="CBTransport_SelectionChanged"/>
        </StackPanel>

        <ListView x:Name="LVRoutes"
                  Grid.Row="1"
                  HorizontalContentAlignment="Stretch"
                  SelectionChanged="LVRoutes_SelectionChanged">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding Name}"/>
                            <TextBlock Text="{Binding RouteDescription}"/>
                            <TextBlock Text="{Binding Transport.Name}"/>
                        </StackPanel>

                        <Image Grid.Column="1" 
                            Source="{Binding RouteMap}"
                               Width="200"/>
                        
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
            
        </ListView>
        

    </Grid>
</Page>
