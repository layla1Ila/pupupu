<Page x:Class="Book.Pages.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Book.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="MainPage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Книжный каталог" FontSize="20" Margin="5"/>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Поиск: "/>
                <TextBox x:Name="TBSearch"
                         Width="200"
                         TextChanged="TBSearch_TextChanged"/>
                <TextBlock Text="Жанр: "/>
                <ComboBox x:Name="CBGenres"
                          DisplayMemberPath="Name"
                          Width="200"
                          SelectionChanged="CBGenres_SelectionChanged"/>
                <TextBlock Text="Автор: "/>
                <ComboBox x:Name="CBAuthors"
                          DisplayMemberPath="FullName"
                          Width="200"
                          SelectionChanged="CBAuthors_SelectionChanged"/>
            </StackPanel>
        </StackPanel>
        <ListView x:Name="LVBooks"
                  Grid.Row="1"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  MouseDoubleClick="LVBooks_MouseDoubleClick">
            <ListView.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel/>
                </ItemsPanelTemplate>
            </ListView.ItemsPanel>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="Black"
                            BorderThickness="1"
                            Width="170"
                            Height="280"
                            CornerRadius="5">
                        <StackPanel>
                            <Border BorderThickness="1"
                                    HorizontalAlignment="Right"
                                    CornerRadius="20"
                                    Margin="5"
                                    Background="{Binding Genre.Color}">
                                <TextBlock HorizontalAlignment="Center"
                                           Text="{Binding Genre.Name}"/>
                            </Border>
                            
                            <Image Width="104"
                                   Height="144"
                                   Source="{Binding Image, TargetNullValue=/VariableLibrary;component/BookImages/book_placeholder.png}" />
                            <TextBlock Text="{Binding Title}"/>
                            <TextBlock Text="{Binding Author.FullName}"/>
                            <TextBlock Text="{Binding Rating}"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
            
            
        </ListView>
    </Grid>
</Page>
