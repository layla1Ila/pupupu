<Page x:Class="Book.Pages.BookPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Book.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="BookPage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="{Binding Title}"
                   FontSize="48"/>
        <Button x:Name="BBack"
                Content="Назад"
                Click="BBack_Click"
                HorizontalAlignment="Right"
                Width="100"
                Height="30"/>
        <StackPanel Grid.Row ="1">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Author.FullName}"/>
                <TextBlock Text="{Binding Genre.Name}"/>
                <TextBlock Text="{Binding Rating}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <Image Source="{Binding Image}"
                       Height="210"
                       Width="160"/>
                <TextBlock Text="{Binding Description}"
                           TextWrapping="WrapWithOverflow"
                           Width="450"/>
            </StackPanel>
        </StackPanel>
        <ListView x:Name="LVBooks"
                  Grid.Row="2"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  MouseDoubleClick="LVBooks_MouseDoubleClick">
            <ListView.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel/>
                </ItemsPanelTemplate>
            </ListView.ItemsPanel>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <StackPanel>
                    <Border BorderBrush="Black"
                            BorderThickness="1"
                            HorizontalAlignment="Right"
                            CornerRadius="20"
                            Width="120"
                            Margin="5">
                        <TextBlock HorizontalAlignment="Center"
                                   Text="{Binding Genre.Name}"/>
                    </Border>
                    <Image Width="104"
                           Height="144"
                           Source="{Binding Image}"/>
                    <TextBlock Text="{Binding Title}"/>
                    <TextBlock Text="{Binding Author.FullName}"/>
                    <TextBlock Text="{Binding Rating}"/>
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
