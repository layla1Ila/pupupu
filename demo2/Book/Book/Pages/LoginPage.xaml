<Page x:Class="Book.Pages.LoginPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Book.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="LoginPage">

    <Grid>
        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Width="200">
            <TextBox BorderBrush="Black" BorderThickness="1.5"
                     x:Name="TBLoginCode" IsReadOnly="True"/>
            <TextBlock Text="Введите код проверки" Margin="5"/>
            <TextBox x:Name="TBCheckLogin" Margin="5"/>
            <Button x:Name="Blogin"
                    Content="Подтвердить"
                    Click="BLogin_Click"
                    Margin="5"/>
        </StackPanel>
    </Grid>
</Page>
